{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "boussole venue bundle",
  "type": "object",
  "required": ["schema", "id", "name", "lang", "origin", "plan", "reperes"],
  "additionalProperties": false,
  "definitions": {
    "latlon": {
      "type": "object",
      "required": ["lat", "lon"],
      "additionalProperties": false,
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "i18n": {
      "type": "object",
      "properties": { "fr": { "type": "string" }, "en": { "type": "string" } },
      "additionalProperties": false
    },
    "tableau": {
      "type": "object",
      "required": ["kind", "trigger"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["texte", "image", "boucle", "son"] },
        "trigger": { "enum": ["approche", "arrivee", "regard", "zone"] },
        "src": { "type": "string" },
        "text": { "$ref": "#/definitions/i18n" },
        "loop": { "type": "boolean" },
        "zone": {
          "type": "array", "minItems": 3,
          "items": { "type": "array", "minItems": 2, "items": { "type": "number" } }
        }
      }
    }
  },
  "properties": {
    "schema": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string" },
    "licence": { "type": "string" },
    "lang": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "origin": { "$ref": "#/definitions/latlon" },
    "media": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    },
    "plan": {
      "type": "object",
      "required": ["src", "width", "height", "controlPoints"],
      "additionalProperties": false,
      "properties": {
        "src": { "type": "string" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "controlPoints": {
          "type": "array", "minItems": 3,
          "items": {
            "type": "object",
            "required": ["px", "py", "lat", "lon"],
            "additionalProperties": false,
            "properties": {
              "px": { "type": "number" }, "py": { "type": "number" },
              "lat": { "type": "number" }, "lon": { "type": "number" }
            }
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "captureRadius": { "type": "number" },
        "revealRadius": { "type": "number" },
        "arRange": { "type": "number" },
        "strideLength": { "type": "number" },
        "planMode": { "enum": ["north-up", "heading-up"] }
      }
    },
    "debug": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startPose": {
          "type": "object",
          "required": ["lat", "lon"],
          "properties": {
            "lat": { "type": "number" }, "lon": { "type": "number" },
            "heading": { "type": "number" }, "accuracy": { "type": "number" }
          }
        }
      }
    },
    "ancres": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "lat", "lon"],
        "properties": {
          "id": { "type": "string" },
          "lat": { "type": "number" }, "lon": { "type": "number" },
          "label": { "type": "string" }
        }
      }
    },
    "reperes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "lat", "lon", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["repere"] },
          "lat": { "type": "number" }, "lon": { "type": "number" },
          "name": { "$ref": "#/definitions/i18n" },
          "hint": { "$ref": "#/definitions/i18n" },
          "tableaux": { "type": "array", "items": { "$ref": "#/definitions/tableau" } },
          "hidden": { "type": "boolean" },
          "captureRadius": { "type": "number" },
          "revealRadius": { "type": "number" }
        }
      }
    },
    "parcours": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "ordered", "reperes"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "$ref": "#/definitions/i18n" },
          "ordered": { "type": "boolean" },
          "reperes": { "type": "array", "items": { "type": "string" } },
          "reward": { "type": "string" }
        }
      }
    }
  }
}
